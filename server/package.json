{
  "name": "techquiz-arena-server",
  "version": "1.0.0",
  "description": "TechQuiz Arena backend server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp -f src/db/schema.sql dist/server/src/db/schema.sql",
    "start": "node dist/server/src/index.js",
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest",
    "loadtest": "node dist/server/tests/loadtest.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.16.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/pdfkit": "^0.13.9",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
